# PostgreSQL connection string (Neon, Vercel Postgres, Supabase, or local Postgres).
# Neon example (use the "Pooled connection" string for the app at runtime):
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Direct (non-pooler) Neon connection. Required by import/maintenance scripts:
# their interactive transactions cannot run over the pooled (pgBouncer)
# endpoint. Leave this UNSET in Vercel so the app keeps using the pooled URL.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST-without-pooler/DBNAME?sslmode=require"
