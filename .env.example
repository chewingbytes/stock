# PostgreSQL connection string (Neon, Vercel Postgres, Supabase, or local Postgres).
# Neon example (use the "Pooled connection" string for the app at runtime):
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
